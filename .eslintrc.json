{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "import/extensions": ["error", "always", { "js": "never" }],
    "no-console": "off",
    "no-underscore-dangle": ["error", { "allow": ["_id"] }]
  }
} 