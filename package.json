{
  "name": "poc",
  "version": "1.0.0",
  "description": "MERN + MySQL Backend POC for Cursive AI Hands-on",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker:email": "node src/jobs/emailWorker.js",
    "worker:audit": "node src/jobs/auditWorker.js",
    "worker:session": "node src/jobs/sessionWorker.js",
    "workers": "concurrently \"npm run worker:email\" \"npm run worker:audit\" \"npm run worker:session\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run workers\"",
    "migrate": "node src/migrations/create_audit_and_session_tables.js",
    "test": "node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "keywords": [
    "node",
    "express",
    "mysql",
    "jwt",
    "authentication",
    "oauth",
    "redis",
    "swagger"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.12.0",
    "connect-redis": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "google-auth-library": "^9.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "mariadb": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.5",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "rate-limiter-flexible": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "nodemon": "^2.0.22",
    "prettier": "^3.2.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.3.2",
    "whatwg-fetch": "^3.6.20"
  }
}
